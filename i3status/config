general {
    colors = true
    interval = 5
    color_good = "#858C87"
    color_degraded = "#C1BFB1"
    color_bad = "#543C46"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "load"
order += "memory"
order += "disk /"
order += "tztime local"

wireless _first_ {
    format_up = "W: %essid (%quality at %bitrate)"
    format_down = "W: down"
}

ethernet _first_ {
    format_up = "E: %ip"
    format_down = "E: down"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = ""
    status_chr = "CHR"
    status_bat = "BAT"
    status_unk = "?"
    status_full = "FULL"
    low_threshold = 15
    threshold_type = percentage
}

load {
    format = "CPU %1min"
}

memory {
    format = "RAM %used"
    threshold_degraded = "1G"
    format_degraded = "RAM %used"
}

disk "/" {
    format = "SSD %avail"
    low_threshold = 10
    threshold_type = percentage_free
}

tztime local {
    format = "%a %d %b  %H:%M"
}

